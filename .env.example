# URL del backend (sin /api al final)
VITE_API_URL=http://localhost:3000

# Clave del SITIO de reCAPTCHA v2 (casilla "No soy un robot") para el checkout.
# Se crea en https://www.google.com/recaptcha/admin/create (v2 > casilla), con los dominios
# localhost y el de Vercel. La clave SECRETA va en el backend (RECAPTCHA_SECRET_KEY).
# Vacía = no se muestra la casilla (sirve en desarrollo si el backend tampoco tiene la secreta).
VITE_RECAPTCHA_SITE_KEY=
